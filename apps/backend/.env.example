# Database (required for production)
# Use Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Legacy local SQLite (fallback if DATABASE_URL is not set)
# KIMI_DB_PATH=data/dashboard.db

# API Server
KIMI_API_HOST=0.0.0.0
KIMI_API_PORT=8000

# CORS — add your Vercel frontend domain
KIMI_CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# Execution limits
KIMI_MAX_CONCURRENT_JOBS=3
KIMI_SCRIPT_TIMEOUT=300
KIMI_JOB_ORPHAN_THRESHOLD=600

# Logging
KIMI_LOG_LEVEL=INFO
