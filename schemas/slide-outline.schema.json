{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kimi.agent.pack/schemas/slide-outline.schema.json",
  "title": "Slide Outline",
  "description": "PPT大纲结构，定义叙事结构和每页slide的核心信息",
  "type": "object",
  "required": ["title", "slides"],
  "properties": {
    "title": {
      "type": "string",
      "description": "PPT整体标题",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "description": "副标题或补充说明"
    },
    "narrative_arc": {
      "type": "string",
      "description": "叙事主线描述",
      "enum": ["context-problem-analysis-conclusion-recommendation", "chronological", "comparison", "hierarchy", "problem-solution"]
    },
    "total_slides": {
      "type": "integer",
      "description": "预计总页数",
      "minimum": 1
    },
    "slides": {
      "type": "array",
      "description": "slide大纲数组",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["slide_id", "title", "key_message"],
        "properties": {
          "slide_id": {
            "type": "string",
            "description": "slide唯一标识符",
            "pattern": "^slide-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "description": "slide页面标题",
            "minLength": 1
          },
          "key_message": {
            "type": "string",
            "description": "该页slide的核心观点（不超过20中文字符/50英文字符）",
            "maxLength": 100
          },
          "bullets": {
            "type": "array",
            "description": "支撑key message的要点（预览用，详细内容在slide-content.json中）",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "string",
            "description": "页面布局类型",
            "enum": ["cover", "title", "content", "two-column", "comparison", "data", "chart", "summary", "closing"]
          },
          "notes": {
            "type": "string",
            "description": "slide设计备注"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
