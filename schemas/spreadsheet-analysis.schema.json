{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kimi.agent/schemas/spreadsheet-analysis/v2.3.0",
  "title": "Spreadsheet Analysis Result",
  "description": "Structured result from spreadsheet analysis including file info, column profiles, summary statistics, and anomaly detection.",
  "type": "object",
  "required": ["file_info", "columns", "summary", "anomalies"],
  "properties": {
    "file_info": {
      "type": "object",
      "description": "Metadata about the analyzed file",
      "required": ["filename", "format", "encoding", "size_bytes", "row_count", "column_count"],
      "properties": {
        "filename": {
          "type": "string",
          "description": "Name of the analyzed file"
        },
        "format": {
          "type": "string",
          "enum": ["csv", "xlsx", "xls", "tsv"],
          "description": "File format"
        },
        "encoding": {
          "type": "string",
          "description": "Detected text encoding (e.g., UTF-8, GBK, Latin-1)"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of data rows (excluding header)"
        },
        "column_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of columns"
        },
        "sampling_applied": {
          "type": "boolean",
          "default": false,
          "description": "Whether sampling was used due to file size"
        },
        "sampling_note": {
          "type": "string",
          "description": "Description of sampling strategy if applied"
        }
      }
    },
    "columns": {
      "type": "array",
      "description": "Per-column profile and statistics",
      "items": {
        "type": "object",
        "required": ["name", "type", "null_count", "unique_count"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Column name"
          },
          "type": {
            "type": "string",
            "enum": ["numeric", "string", "datetime", "boolean", "mixed", "unknown"],
            "description": "Inferred data type"
          },
          "null_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of null/missing values"
          },
          "null_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Ratio of null values (0.0 to 1.0)"
          },
          "unique_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of unique values"
          },
          "unique_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Ratio of unique values"
          },
          "stats": {
            "type": "object",
            "description": "Type-specific statistics",
            "properties": {
              "numeric": {
                "type": "object",
                "description": "Statistics for numeric columns",
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "mean": { "type": "number" },
                  "median": { "type": "number" },
                  "std": { "type": "number" },
                  "q1": { "type": "number", "description": "First quartile" },
                  "q3": { "type": "number", "description": "Third quartile" },
                  "iqr": { "type": "number", "description": "Interquartile range" }
                }
              },
              "string": {
                "type": "object",
                "description": "Statistics for string columns",
                "properties": {
                  "min_length": { "type": "integer", "minimum": 0 },
                  "max_length": { "type": "integer", "minimum": 0 },
                  "avg_length": { "type": "number", "minimum": 0 },
                  "sample_values": {
                    "type": "array",
                    "items": { "type": "string" },
                    "maxItems": 5,
                    "description": "Sample of representative values"
                  }
                }
              },
              "datetime": {
                "type": "object",
                "description": "Statistics for datetime columns",
                "properties": {
                  "earliest": { "type": "string", "format": "date-time" },
                  "latest": { "type": "string", "format": "date-time" },
                  "date_range_days": { "type": "integer", "description": "Span in days" }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Overall dataset summary",
      "required": ["total_rows", "total_columns", "total_cells", "total_nulls", "null_ratio"],
      "properties": {
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "total_columns": {
          "type": "integer",
          "minimum": 0
        },
        "total_cells": {
          "type": "integer",
          "minimum": 0,
          "description": "total_rows × total_columns"
        },
        "total_nulls": {
          "type": "integer",
          "minimum": 0
        },
        "null_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "memory_estimate_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated memory footprint in MB"
        },
        "correlation_matrix": {
          "type": "object",
          "description": "Pearson correlation matrix for numeric columns",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "description": "Detected anomalies and outliers",
      "items": {
        "type": "object",
        "required": ["column", "type", "details"],
        "properties": {
          "column": {
            "type": "string",
            "description": "Column where anomaly was detected"
          },
          "type": {
            "type": "string",
            "enum": ["outlier_iqr", "outlier_zscore", "missing_values", "type_mismatch", "duplicate", "format_inconsistency", "range_violation"],
            "description": "Category of anomaly"
          },
          "method": {
            "type": "string",
            "description": "Detection method used (e.g., 'IQR', 'Z-score', 'exact match')"
          },
          "details": {
            "type": "object",
            "description": "Detailed anomaly information",
            "required": ["count"],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of anomalous values"
              },
              "ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Ratio of anomalous values"
              },
              "examples": {
                "type": "array",
                "items": {},
                "maxItems": 10,
                "description": "Sample anomalous values"
              },
              "bounds": {
                "type": "object",
                "description": "For outlier detection: lower and upper bounds",
                "properties": {
                  "lower": { "type": "number" },
                  "upper": { "type": "number" }
                }
              },
              "threshold": {
                "type": "number",
                "description": "Threshold used for detection (e.g., Z-score threshold)"
              }
            }
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the analysis was generated"
    },
    "agent_version": {
      "type": "string",
      "description": "Version of the spreadsheet agent"
    }
  }
}
