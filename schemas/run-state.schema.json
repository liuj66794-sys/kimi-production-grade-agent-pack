{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kimi-agent-pack/schemas/run-state.schema.json",
  "title": "Run State",
  "description": "Schema for guided-run runtime state tracking",
  "type": "object",
  "required": [
    "case_id",
    "current_step",
    "completed_steps",
    "blocked_steps",
    "step_status",
    "artifacts",
    "timestamp",
    "version"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique case identifier for multi-task isolation",
      "minLength": 1
    },
    "current_step": {
      "type": "string",
      "description": "Name of the currently active step",
      "enum": [
        "task-intake",
        "researcher",
        "analyst",
        "evidence-synthesis",
        "writer",
        "qa-reviewer",
        "release",
        "idle",
        "unknown"
      ]
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "task-intake",
          "researcher",
          "analyst",
          "evidence-synthesis",
          "writer",
          "qa-reviewer",
          "release"
        ]
      },
      "description": "List of completed step names"
    },
    "blocked_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of blocked step names with reasons"
    },
    "step_status": {
      "type": "object",
      "description": "Status mapping for each step",
      "required": [
        "task-intake",
        "researcher",
        "analyst",
        "evidence-synthesis",
        "writer",
        "qa-reviewer",
        "release"
      ],
      "additionalProperties": false,
      "properties": {
        "task-intake": {
          "$ref": "#/definitions/step_status_value"
        },
        "researcher": {
          "$ref": "#/definitions/step_status_value"
        },
        "analyst": {
          "$ref": "#/definitions/step_status_value"
        },
        "evidence-synthesis": {
          "$ref": "#/definitions/step_status_value"
        },
        "writer": {
          "$ref": "#/definitions/step_status_value"
        },
        "qa-reviewer": {
          "$ref": "#/definitions/step_status_value"
        },
        "release": {
          "$ref": "#/definitions/step_status_value"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Artifact paths produced by each step",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "properties": {
        "task-intake": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "researcher": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analyst": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence-synthesis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qa-reviewer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "release": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of last state update"
    },
    "version": {
      "type": "string",
      "description": "Run state schema version",
      "enum": ["1.5", "1.6"]
    },
    "run_metadata": {
      "type": "object",
      "description": "Additional run metadata",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the run started"
        },
        "last_updated_by": {
          "type": "string",
          "description": "What updated the state last"
        },
        "resume_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times this run was resumed"
        },
        "total_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Total retry count across all steps"
        }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "reason", "error_code"],
        "properties": {
          "step": {
            "type": "string",
            "description": "Step that is blocked"
          },
          "reason": {
            "type": "string",
            "description": "Human-readable block reason"
          },
          "error_code": {
            "type": "string",
            "description": "Error code (e.g., E003-E018)",
            "pattern": "^E0[0-9]{2}$"
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "When the block occurred"
          }
        }
      },
      "description": "Reasons why steps are blocked"
    }
  },
  "definitions": {
    "step_status_value": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked",
        "incomplete",
        "failed",
        "skipped"
      ],
      "description": "Status of a single step"
    }
  }
}
